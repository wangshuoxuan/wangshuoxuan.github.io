rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  // The owner's verified Firebase user ID. Readers cannot change this rule.
  function owner() { return signedIn() && request.auth.uid == '2ytP6EY42HhBq721CWb900qgOoE3'; }
  function throttlePath() { return /databases/$(database)/documents/message_limits/$(request.auth.uid); }
  match /reader_messages/{message} {
   allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','post_path','body','created_at'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.body is string
    && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000
    && request.resource.data.post_path is string
    && request.resource.data.post_path.matches('/post-[a-z0-9-]+[.]html')
    && request.resource.data.created_at == request.time
    && getAfter(throttlePath()).data.last_message == request.time
    && (!exists(throttlePath()) || get(throttlePath()).data.last_message < request.time - duration.value(60,'s'));
   allow update: if owner()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','replied_at'])
    && request.resource.data.reply is string && request.resource.data.reply.size() <= 5000
    && request.resource.data.replied_at == request.time;
   allow delete: if false;
  }
  match /message_limits/{uid} {
   allow read: if signedIn() && uid == request.auth.uid;
   allow create, update: if signedIn() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['last_message'])
    && request.resource.data.last_message == request.time
    && (!exists(throttlePath()) || resource.data.last_message < request.time - duration.value(60,'s'));
   allow delete: if false;
  }
 }
}
